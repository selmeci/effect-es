{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnosticSeverity": { "floatingEffect": "error" },
        "ignoreEffectSuggestionsInTscExitCode": true,
        "ignoreEffectWarningsInTscExitCode": false,
        "ignoreEffectErrorsInTscExitCode": false,
        "allowedUnstableApis": [
          "effect/ai/DecisionModel#DecisionModel",
          "effect/ai/DecisionModel#TypeId",
          "effect/ai/DecisionModel#DecisionUsage",
          "effect/ai/AiError#make",
          "effect/ai/AiError#UnknownError",
          "effect/ai/AiError#NetworkError"
        ]
      }
    ]
  },
  "include": ["src", "test"]
}
