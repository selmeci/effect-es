{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "ignorePatterns": ["repos/**", "node_modules/**", "dist/**", "coverage/**"],
  "jsPlugins": ["./tools/oxlint/syntax-bans.js", "@nx/oxlint/boundaries-plugin"],
  "rules": {
    "@nx/enforce-module-boundaries": [
      "error",
      {
        "enforceBuildableLibDependency": true,
        "depConstraints": [
          { "sourceTag": "type:contract", "onlyDependOnLibsWithTags": ["type:contract"] },
          { "sourceTag": "type:domain", "onlyDependOnLibsWithTags": ["type:contract", "type:domain"] },
          { "sourceTag": "type:service", "onlyDependOnLibsWithTags": ["type:contract", "type:domain", "type:service"] },
          { "sourceTag": "type:infra", "onlyDependOnLibsWithTags": ["type:contract", "type:domain", "type:service", "type:infra"] },
          { "sourceTag": "type:app", "onlyDependOnLibsWithTags": ["type:contract", "type:domain", "type:service", "type:infra", "type:app"] },
          { "sourceTag": "*", "onlyDependOnLibsWithTags": ["*"] }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["libs/**/src/**/*.ts", "apps/**/src/**/*.ts"],
      "rules": {
        "harness/syntax-bans": "error",
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "drizzle-orm",
                "message": "drizzle-orm is infra-only — import it only in type:infra libraries; repositories decode rows into contract Schemas (mvp.md, Application stack). Escape hatch: an oxlint-disable comment, foreign boundaries only."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/infra/src/**/*.ts", "**/infra/test/**/*.ts"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
